{
  "name": "foodylanding",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "test:marketing": "node scripts/check-marketing.mjs",
    "test:measurement": "node --test scripts/marketing-measurement.test.mjs",
    "audit:discovery": "node scripts/audit-discovery.mjs",
    "social:generate": "node scripts/generate-social-card.mjs",
    "prebuild": "npm run check:help",
    "predev": "npm run check:help",
    "check:help": "node scripts/render-help-guides.mjs --check && node scripts/check-help.mjs && node scripts/export-help-release.mjs && node scripts/check-help-ui.mjs",
    "test:help": "node --test scripts/help.test.mjs scripts/help-contract.test.mjs scripts/help-ui.test.mjs",
    "render:help": "node scripts/render-help-guides.mjs",
    "test:food-cost": "node --test scripts/food-cost.test.mjs",
    "test:analytics": "node --test scripts/marketing-measurement.test.mjs scripts/google-analytics.test.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "15.5.28",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8",
    "eslint-config-next": "15.5.28",
    "typescript": "^5"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.26",
    "browserslist": "4.29.1",
    "nanoid": "3.3.19",
    "next": {
      "postcss": "8.5.28"
    }
  }
}
